# pblhl Run Time Configuration
#------------------------------
setenv GID s0818
setenv ARCH `uname -s`
setenv HOST `uname -n`
setenv NODEFLG mil
setenv GTAG 352855d
setenv RTAG 352855d
setenv EXPID pblhl
setenv FVHOME /discover/nobackup/projects/gmao/obsdev/eyang2/PBLH/Exp/${EXPID}
setenv FVROOT /discover/nobackup/projects/gmao/obsdev/eyang2/GEOSadas-5.42.11/GEOSadas/install-SLES15
setenv FVROOT_PORTAL /discover/nobackup/projects/gmao/obsdev/eyang2/GEOSadas-5.42.11/GEOSadas/install-SLES15
setenv FVSHARE /discover/nobackup/projects/gmao/share/dao_ops/
if (! $?SHARE) setenv SHARE /discover/nobackup/projects/gmao/share
setenv GRADS_CONFIG "$FVSHARE/opengrads/setup.csh 1.9.8"
setenv REM_GRADS_CONFIG "/discover/nobackup/projects/gmao/share/dasilva/opengrads/setup.csh 1.9.8"
setenv G5MGRAM snare:/www/html/products/nwp/meteogram/cities
setenv LATS4DLOC /home/dao_ops/operations/GrADS/current/
setenv FVARCH /discover/nobackup/projects/gmao/obsdev/eyang2/archive/physical_PBLH
setenv FVSPOOL $FVHOME/spool
setenv BASEDIR /discover/swdev/gmao_SIteam/Baselibs/ESMA-Baselibs-7.24.0/x86_64-pc-linux-gnu/ifort_2021.6.0-intelmpi_2021.13.0-SLES15
setenv PYRADMON /discover/nobackup/jstassi/GEOSadas/pyradmon
#------------------------------
setenv G5MODULES "GEOSenv comp/gcc/11.4.0 comp/intel/2021.6.0 mpi/impi/2021.13 python/GEOSpyD/Min23.5.2-0_py3.11"
source $FVROOT/bin/g5_modules
#------------------------------
setenv FVBCS $FVHOME/fvInput
setenv NCEPINPUT $FVBCS
setenv RC_LOC /discover/nobackup/projects/gmao/obsdev/eyang2/PBLH/Exp/pblhl/run
setenv FVGROUP $GID
setenv FVSCRA $NOBACKUP/scratch
setenv FVSILO $FVSCRA/$EXPID
setenv FVSTAGE /staging/dao_ops/$GTAG/$EXPID
setenv FVBIN /home/dao_ops/bin
setenv FVPORTAL /portal/GMAO/gmao_ops/
setenv FVWORK $TMPDIR/fvwork.$$
setenv ERROR_LOG_NAME "-L DEFAULT"
setenv ERROR_ID ops
setenv ERROR_EXP $EXPID
setenv ERR "Err_Log.pl -N $EXPID.job -I $ERROR_ID -X $ERROR_EXP $ERROR_LOG_NAME"
setenv FCSTID fblhl
setenv FCHOME $FVHOME/run/fcst
setenv FCSTAGE $FVHOME/fcst
setenv FERR "Err_Log.pl -N $FCSTID.job -I $ERROR_ID -X $FCSTID $ERROR_LOG_NAME"
setenv ANAID $EXPID
setenv ANASTAGE /discover/nobackup/dao_ops/intermediate/flk/stage/g5ana
setenv RSTINC 21600
setenv PBS_BIN "/usr/bin"
setenv PLOTS_LOC eyang2@train:/gmao/intranet/research/modeling/agcm/geos5/$EXPID  # Monthly Plots Web server location
setenv GEOSUTIL /discover/nobackup/projects/gmao/obsdev/eyang2/GEOSadas-5.42.11/GEOSadas/install-SLES15
setenv MERRAID pblhl
setenv STNOBS ~/stnobs/stnobs_v3.3/
setenv LIBSZ $BASEDIR/$ARCH/lib
setenv FVDMGET /usr/bin/dmget
setenv PBS_ID FP
setenv RUN_MEANS 1
setenv MONTHLY_X "$FVROOT/bin/time_ave.x"
setenv FVDOLMS polar:/www2/science/dolms/$EXPID/TERRA_mm
setenv CASE $EXPID
setenv OMP_NUM_THREADS 1
setenv ARCH_QUEUE "-q datamove"
setenv POST_CPUS 1
setenv VTXRELOC 1
setenv VTRACK 1
setenv VTXLEVS "1000 925 850 700 600 500 400 300 250 200 150 100 70 50 30 20 10"
